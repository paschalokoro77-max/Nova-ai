# GEMINI_API_KEY: Required for optional Gemini AI market commentary (server-side only).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client & Server)
# Set these once you connect your existing Supabase project.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side ONLY — NEVER expose this in frontend code or VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional self-hosted IQ Option Python connector (unofficial iqoptionapi · PRACTICE / read-only)
# Store ONLY the base URL (e.g. https://your-iq-connector.example) — do NOT include "IQ_CONNECTOR_URL=" or localhost when deployed separately.
IQ_CONNECTOR_URL=""
IQ_CONNECTOR_TOKEN=""

# Required in NODE_ENV=production (>= 32 chars): HMAC signing secret for Android Companion tokens and AES-256-GCM broker credential vault key
ANDROID_BRIDGE_SECRET=""
BROKER_VAULT_SECRET=""

# Optional MetaTrader 5 Official Python SDK Bridge (hosted on Windows/VPS alongside running MT5 terminal; supports Demo or Real connected account)
MT5_BRIDGE_URL=""
MT5_BRIDGE_TOKEN=""
MT5_DEMO_LOGIN=""
MT5_DEMO_SERVER="MetaQuotes-Demo"

# Optional standalone Python AI engine URL
AI_ENGINE_URL=""

